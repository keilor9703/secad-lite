# Copiar a .env y ajustar. El .env real NO se versiona.
PORT=3000

# PostgreSQL (modelo pooled: una sola base, aislada por columna tenant).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/secad_lite

# Secreto para firmar los JWT. En producción: valor largo y aleatorio, por secreto.
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES=8h

# Esquema de base de datos:
#  - Dev (por defecto): DB_SYNC=true crea/actualiza tablas automáticamente.
#  - Producción: DB_SYNC=false y DB_MIGRATE=true para aplicar migraciones
#    versionadas (src/migrations) al arrancar. Ver README.
DB_SYNC=true
DB_MIGRATE=false

# TLS contra la base. Las gestionadas (Supabase, Neon, RDS…) lo exigen; en
# local con Docker se deja en false. Ver docs/despliegue-demo.md.
DB_SSL=false

# Dominios autorizados a llamar la API desde un navegador, separados por comas.
# Admite comodín de subdominio para las vistas previa, que cambian de URL en
# cada commit. Vacío = sin restricción (cómodo en desarrollo, no al publicar).
# CORS_ORIGINS=https://falcon-cad.vercel.app,https://*.vercel.app,http://localhost:4200

# Firma de los webhooks de WhatsApp (app secret de la aplicación de Meta).
# Con el valor puesto, todo POST al webhook debe traer X-Hub-Signature-256
# válida. Sin él: en desarrollo se acepta con advertencia; en producción el
# webhook queda deshabilitado (mejor caído que falsificable).
# WHATSAPP_APP_SECRET=

# Acceso ciudadano de demostración (cualquier correo + contraseña "demo").
# Fuera de producción está encendido; publicado, SOLO funciona con este flag
# explícito. No lo encienda en una instancia con datos reales.
# DEMO_CIVIL=true

# CA del proveedor de la base (PEM completo) para validar el TLS de verdad.
# Sin ella, DB_SSL=true cifra sin validar la cadena — el servidor podría ser
# suplantado (man-in-the-middle). En producción SIEMPRE configure esta variable.
# Supabase: descárguela de Settings > Database > SSL Certificate.
# Neon: descárguela de Connection Details > SSL certificate.
# RDS: https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/UsingWithRDS.SSL.html
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Redis: solo hace falta con MÁS DE UNA instancia del backend corriendo a la
# vez (redundancia, despliegues sin downtime). Sin esta variable, el aviso en
# vivo (Socket.IO) y el tope de intentos de login viven en la memoria de cada
# instancia por separado — correcto con una sola instancia, incorrecto con
# varias. Con ella, se comparten entre todas por Redis. Ver docs/despliegue-demo.md.
# REDIS_URL=redis://usuario:password@host:6379
