# Copiar a .env y ajustar. El .env real NO se versiona.
PORT=3000

# PostgreSQL (modelo pooled: una sola base, aislada por columna tenant).
DATABASE_URL=postgres://secad:secad@127.0.0.1:5432/secad_lite

# Secreto para firmar los JWT. En producción: valor largo y aleatorio, por secreto.
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES=8h
