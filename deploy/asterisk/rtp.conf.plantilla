;
; rtp.conf — por dónde viaja el audio
;
; Reemplace: IP_PUBLICA
;

[general]
;; El rango de siempre. No hay por qué estrecharlo: ver el comentario de
;; abajo sobre las reglas stateful.
rtpstart = 10000
rtpend = 20000

;; ───────────────────────────────────────────────────────────────────────────
;; SIN ESTO, EL NAVEGADOR CONTESTA Y LA LLAMADA SE CAE
;;
;; El navegador exige ICE, y en ICE cada extremo publica las direcciones por
;; las que se le puede alcanzar. Asterisk, por su cuenta, solo conoce la IP
;; de su tarjeta de red — que en una nube es **privada** (10.0.0.112). El
;; navegador recibe esa candidata, no puede alcanzarla, no hay otra, y la
;; negociación de medios fracasa: la llamada se contesta y se cuelga sola,
;; sin un error que lo explique.
;;
;; `stunaddr` hace que Asterisk le pregunte a un servidor STUN cuál es su IP
;; vista desde fuera, y publique ESA. Es el mismo problema —y la misma
;; solución— que el navegador resuelve con los iceServers de FALCON.
;;
;; `icesupport` ya viene en «yes» por defecto en Asterisk 18; se escribe
;; explícito porque de esto depende que haya audio o no.
;; ───────────────────────────────────────────────────────────────────────────
icesupport = yes
stunaddr = stun.l.google.com:19302

;; Y por si el STUN no responde, la dirección a la fuerza. Las dos juntas no
;; estorban: STUN la descubre, esto la garantiza.
;; (Si la máquina tiene IP pública directa en su tarjeta, sobra.)
;; externaddr se configura en el transporte de pjsip.conf
;; (external_media_address), no aquí.

;; Checksums de UDP: cuestan muy poco y detectan corrupción en el camino.
rtpchecksums = yes
