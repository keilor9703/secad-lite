;
; rtp.conf — por dónde viaja el audio
;
; Reemplace: RTP_INICIO, RTP_FIN
;
; ───────────────────────────────────────────────────────────────────────────
; EL RANGO NORMAL ES 10000-20000, Y NO HAY QUE ESTRECHARLO «POR SI ACASO»
;
; Hubo la tentación de meterlo dentro del único rango que la nube tenía
; abierto, para no depender del cortafuegos. Resultó que ese rango tampoco
; estaba abierto (§6.6), así que estrecharlo no compraba nada y solo reducía
; las llamadas simultáneas.
;
; Lo que hace que el audio entre sin tener el puerto permitido son las reglas
; STATEFUL de la nube: el primer paquete que Asterisk manda hacia afuera abre
; el flujo y el retorno entra por ahí. `rtp_symmetric = yes` en el endpoint es
; lo que lo sostiene. Puede haber un recorte en el primer segundo; se comprueba
; con una llamada, no se supone.
;
; Cada llamada usa DOS puertos (RTP y RTCP).
; ───────────────────────────────────────────────────────────────────────────

[general]
rtpstart = RTP_INICIO
rtpend = RTP_FIN
;; Checksums de UDP: dejarlos activados cuesta muy poco y detecta corrupción
;; en el camino, que con un rango prestado es justo lo que uno quiere saber.
rtpchecksums = yes
;; El navegador necesita ICE para atravesar el NAT de la sala de despacho.
icesupport = yes
stunaddr = stun.l.google.com:19302
