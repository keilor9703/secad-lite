;
; pjsip.conf — centralita de FALCON CAD
;
; Reemplace: DOMINIO_CENTRALITA, IP_PUBLICA, IP_DEL_PROVEEDOR,
;            USUARIO_TRONCAL, CLAVE_TRONCAL, SERVIDOR_TRONCAL
;

;; ─────────────────────────────────────────────────────────────────────────
;; TRANSPORTES
;;
;; Dos, porque son dos mundos: los navegadores de los operadores entran por
;; WebSocket seguro, y la troncal del operador telefónico por UDP de toda la
;; vida.
;; ─────────────────────────────────────────────────────────────────────────

[transport-wss]
type = transport
protocol = wss
bind = 0.0.0.0:8089

[transport-udp]
type = transport
protocol = udp
bind = 0.0.0.0:5060
;; SIN ESTAS DOS LÍNEAS: AUDIO DE UNA SOLA VÍA.
;; Asterisk anunciaría su IP privada en el SDP y el audio de vuelta no llega.
;; Es exactamente el mismo problema que ya se vivió del lado del navegador,
;; ahora del lado del servidor.
external_media_address = IP_PUBLICA
external_signaling_address = IP_PUBLICA
;; Las redes de adentro, para que Asterisk sepa cuándo NO reescribir.
local_net = 10.0.0.0/8
local_net = 172.16.0.0/12
local_net = 192.168.0.0/16


;; ─────────────────────────────────────────────────────────────────────────
;; UNA EXTENSIÓN POR OPERADOR
;;
;; `webrtc = yes` activa de un golpe lo que el navegador exige: ICE, DTLS,
;; rtcp-mux y AVPF. Sin eso el registro funciona y la llamada no suena.
;;
;; Los códecs van en ESTE orden a propósito: el navegador habla Opus, y la
;; troncal colombiana casi siempre entrega G.711 (ulaw). Asterisk
;; transcodifica, y eso consume CPU — es la variable que decide el tamaño de
;; la máquina. Mídala con tráfico antes de prometer capacidad.
;;
;; LA CLAVE NO VA AQUÍ EN CLARO EN EL REPOSITORIO. El script la pide y la
;; escribe en /etc/asterisk. La misma clave se registra en FALCON, en el
;; campo «clave SIP» del usuario.
;; ─────────────────────────────────────────────────────────────────────────

[101]
type = endpoint
transport = transport-wss
webrtc = yes
context = entrantes
disallow = all
;; ─────────────────────────────────────────────────────────────────────────
;; ULAW, NO OPUS — y no es por simplificar
;;
;; La tentación es poner `opus` primero: es mejor códec y el navegador lo
;; habla nativo. Pero el paquete de Asterisk de Debian/Ubuntu **no trae el
;; codificador de Opus** (`asterisk-opus` es un paquete aparte, ni siquiera
;; recomendado), y la troncal entrega **ulaw**. Resultado en la primera
;; llamada real:
;;
;;   WARNING: Unable to find a codec translation path: (opus) -> (ulaw)
;;   WARNING: Had to drop call because I couldn't make ... compatible
;;
;; La llamada entra, timbra, el operador contesta — y Asterisk la cuelga él
;; mismo. El mensaje está en el log, pero en la pantalla no se ve nada.
;;
;; Y aunque se instalara `asterisk-opus`, **no conviene**: la troncal es ulaw
;; de 8 kHz, así que transcodificar opus↔ulaw gasta CPU y añade latencia para
;; una calidad que el otro tramo ya limitó. Ulaw de punta a punta es mejor,
;; no solo más fácil.
;; ─────────────────────────────────────────────────────────────────────────
allow = ulaw,alaw
auth = 101
aors = 101
;; El nombre que ve quien recibe una llamada de este operador.
callerid = Operador 101 <101>

[101]
type = auth
auth_type = userpass
username = 101
password = CLAVE_DE_LA_101

[101]
type = aor
max_contacts = 2        ; el operador puede tener dos pestañas abiertas
remove_existing = yes   ; y la tercera desplaza a la más vieja, no falla


;; ─────────────────────────────────────────────────────────────────────────
;; LA TRONCAL DEL OPERADOR
;;
;; Va en un archivo aparte —`pjsip-troncal.conf`— que `instalar.sh` solo
;; escribe si usted le dio los datos del operador. Un bloque de troncal con
;; los campos vacíos no es «una troncal apagada»: es una configuración
;; inválida. En la primera instalación real dejó un `match =` sin nada en el
;; `type=identify`, que es la regla que decide QUIÉN puede entregar llamadas
;; por el 5060 — vacía, no protege nada.
;;
;; Es, además, lo único que cambia al cambiar de proveedor de telefonía.
;; ─────────────────────────────────────────────────────────────────────────
#include pjsip-troncal.conf
