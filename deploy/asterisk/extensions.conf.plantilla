;
; extensions.conf — el dialplan
;
; Reemplace: URL_DE_FALCON, API_KEY_DE_LA_INSTANCIA
;

[general]
static = yes
writeprotect = yes

[globals]
FALCON_URL = URL_DE_FALCON
FALCON_KEY = API_KEY_DE_LA_INSTANCIA


;; ─────────────────────────────────────────────────────────────────────────
;; LO QUE ENTRA
;;
;; AQUÍ ESTÁ EL AHORRO DE TODO EL DISEÑO: no hace falta escribir un traductor
;; de eventos en FALCON, porque este dialplan habla directamente el modelo de
;; FALCON contra el webhook genérico —el mismo por donde entran hoy las
;; llamadas de YACO—. La centralita es nuestra: en vez de que FALCON adivine
;; el idioma de una central ajena, hablamos bien desde el principio.
;;
;; TRES COSAS QUE NO SON ADORNO:
;;
;;  1. El `&` del final y el `-m 3`. Sin ellos, si FALCON tarda en responder,
;;     el dialplan se queda esperando y EL TELÉFONO NO TIMBRA. Avisar nunca
;;     puede retrasar la llamada.
;;  2. `${UNIQUEID}` es el callId, y es lo que ata el «entrante» con el
;;     «colgada» y con la llamada que el navegador ve por SIP. Es el mismo
;;     papel que cumplía `pbx_call_id` con Zadarma.
;;  3. La extensión `h` corre SIEMPRE al colgar, conteste quien conteste y
;;     cuelgue quien cuelgue. Por eso el cierre va ahí y no después del Dial:
;;     con Zadarma se aprendió por las malas que colgar no cerraba la llamada
;;     en FALCON.
;; ─────────────────────────────────────────────────────────────────────────

[entrantes]
;; ─────────────────────────────────────────────────────────────────────────
;; A QUIÉN TIMBRARLE — y por qué no basta con `Dial(PJSIP/${EXTEN})`
;;
;; Entre extensiones, `${EXTEN}` es la extensión marcada y marcarla funciona.
;; Pero la llamada del CIUDADANO entra por el DID (un 1-833…, un 601…), y
;; `Dial(PJSIP/18335308128)` intenta llamar a un endpoint que no existe: la
;; llamada muere sin timbrar en ninguna parte y en el log solo se ve un
;; «chan_pjsip ... not found» que no se parece a su causa.
;;
;; Así que hay que decidir: si lo marcado es una extensión interna, se timbra
;; esa; cualquier otra cosa es el DID y se timbra al operador.
;; ─────────────────────────────────────────────────────────────────────────

;; Interna: 101, 102, 103…
exten => _1XX,1,Set(DESTINO=${EXTEN})
 same => n,Goto(atender,s,1)

;; ─────────────────────────────────────────────────────────────────────────
;; EL CIUDADANO, ENTRANDO POR EL DID — Y POR QUÉ HAY DOS PATRONES
;;
;; `X` en un patrón de Asterisk significa **un dígito del 0 al 9**, y el `+`
;; no lo es. Con solo `_X.`, un DID en E.164 —que es como lo manda Infobip,
;; `+18335308128`— no casa con NADA y la central rechaza la llamada:
;;
;;   Call to extension '+18335308128' rejected because extension not found
;;
;; El mensaje dice la verdad y aun así despista, porque uno lee «_X. casa con
;; cualquier cosa» y no es así. Por eso van los dos: con `+` y sin `+`.
;;
;; Con varios operadores, aquí va una cola (`Queue()`) en vez de una extensión
;; fija; mientras haya uno solo, la 101 es la respuesta honesta.
;; ─────────────────────────────────────────────────────────────────────────
exten => _+X.,1,Set(DESTINO=101)
 same => n,Goto(atender,s,1)

exten => _X.,1,Set(DESTINO=101)
 same => n,Goto(atender,s,1)


[atender]
;; ─────────────────────────────────────────────────────────────────────────
;; AVISARLE A FALCON Y TIMBRAR
;;
;; AQUÍ ESTÁ EL AHORRO DE TODO EL DISEÑO: no hace falta escribir un traductor
;; de eventos en FALCON, porque esto habla directamente su modelo contra el
;; webhook genérico —el mismo por donde entran las llamadas de YACO—. La
;; centralita es nuestra: en vez de que FALCON adivine el idioma de una
;; central ajena, hablamos bien desde el principio.
;;
;; TRES COSAS QUE NO SON ADORNO:
;;
;;  1. El `&` del final y el `-m 3`. Sin ellos, si FALCON tarda en responder,
;;     el dialplan se queda esperando y EL TELÉFONO NO TIMBRA. Avisar nunca
;;     puede retrasar la llamada.
;;  2. `${UNIQUEID}` es el callId, y es lo que ata el «entrante» con el
;;     «colgada» y con la llamada que el navegador ve por SIP. Es el mismo
;;     papel que cumplía `pbx_call_id` con Zadarma.
;;  3. La extensión `h` corre SIEMPRE al colgar, conteste quien conteste y
;;     cuelgue quien cuelgue. Por eso el cierre va ahí y no después del Dial:
;;     con Zadarma se aprendió por las malas que colgar no cerraba la llamada
;;     en FALCON.
;; ─────────────────────────────────────────────────────────────────────────
exten => s,1,NoOp(FALCON entrante ${CALLERID(num)} -> ${DESTINO} id=${UNIQUEID})
 same => n,Set(CDR(userfield)=${UNIQUEID})
 same => n,System(curl -s -m 3 -X POST ${FALCON_URL}/api/pbx/webhook -H "Content-Type: application/json" -H "x-api-key: ${FALCON_KEY}" -d '{"evento":"entrante","callId":"${UNIQUEID}","numero":"${CALLERID(num)}","extension":"${DESTINO}"}' &)
 same => n,Dial(PJSIP/${DESTINO},30)
 same => n,Hangup()

;; Se cuelga: se cierra en FALCON. Pase lo que pase.
exten => h,1,NoOp(FALCON fin id=${UNIQUEID} estado=${DIALSTATUS})
 same => n,System(curl -s -m 3 -X POST ${FALCON_URL}/api/pbx/webhook -H "Content-Type: application/json" -H "x-api-key: ${FALCON_KEY}" -d '{"evento":"colgada","callId":"${UNIQUEID}"}' &)


;; ─────────────────────────────────────────────────────────────────────────
;; LO QUE SALE — el botón «Llamar» del caso
;;
;; ARI crea el canal del OPERADOR y, cuando descuelga, lo manda aquí para que
;; marque al ciudadano. Ese orden importa: si se llamara primero al ciudadano,
;; contestaría a un silencio mientras la central busca a un operador que puede
;; no estar en su puesto.
;;
;; La cola de un CAD es de lo que ENTRA, así que una saliente NO se avisa como
;; «entrante»: no debe aparecer en la cola de Recepción.
;; ─────────────────────────────────────────────────────────────────────────

[salientes]
exten => _X.,1,NoOp(FALCON saliente hacia ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN}@troncal,60)
 same => n,Hangup()

