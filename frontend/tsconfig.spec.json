/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // `google.maps` también aquí, no solo en tsconfig.app.json: en cuanto una
    // prueba importa un componente que usa el SDK de Google, la compilación de
    // las pruebas necesita los mismos tipos de ambiente que la de la app.
    "types": [
      "jasmine",
      "google.maps"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts"
  ]
}
